// niri config mirroring the Hyprland setup in ../hyprland/config.
// KDL format: https://kdl.dev — "/-" comments out the following node.
// Wiki: https://niri-wm.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }
}

// Monitors (hyprland.lua). Unset positions are placed automatically.
output "HDMI-A-1" {
    scale 1
}

output "eDP-1" {
    mode "3840x2400@60.000"
    scale 2
}

// Env vars (hyprland.lua); cursor theme goes through niri's cursor block.
environment {
    NIXOS_OZONE_WL "1"
    LIBVA_DRIVER_NAME "nvidia"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    NVD_BACKEND "direct"
    YDOTOOL_SOCKET "/run/ydotool/socket"
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// Named workspaces stand in for Hyprland's startup workspaces 1-3.
// "magic" stands in for special:magic (niri has no scratchpad).
workspace "1"
workspace "2"
workspace "3"
workspace "magic"

layout {
    // Hyprland gaps_in 2 (per side) + gaps_out 4 => 4 everywhere.
    gaps 4
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    // border_size 2; colors match Stylix's Hyprland target (gruvbox-dark-hard base0D/base03/base08).
    border {
        width 2
        active-color "#83a598"
        inactive-color "#665c54"
        urgent-color "#fb4934"
    }
}

// Autostart (hyprland.lua): editor/browser/terminal on 1/2/3, Noctalia, then focus 2.
spawn-at-startup "emacs"
spawn-at-startup "zen-beta"
spawn-at-startup "wezterm"
spawn-at-startup "noctalia"
spawn-sh-at-startup "sleep 1 && niri msg action focus-workspace 2"

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// animations.lua: Hyprland speed is in 100ms units.
animations {
    // workspaces: speed 8, "overshoot" bezier
    workspace-switch {
        duration-ms 800
        curve "cubic-bezier" 0.5 0.9 0.1 1.1
    }
    // windows: speed 3, "weo_bezier"
    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.84 0.01 0.62 0.95
    }
    window-close {
        duration-ms 300
        curve "cubic-bezier" 0.84 0.01 0.62 0.95
    }
    window-movement {
        duration-ms 300
        curve "cubic-bezier" 0.84 0.01 0.62 0.95
    }
    window-resize {
        duration-ms 300
        curve "cubic-bezier" 0.84 0.01 0.62 0.95
    }
    // global: speed 8, "weo_bezier"
    horizontal-view-movement {
        duration-ms 800
        curve "cubic-bezier" 0.84 0.01 0.62 0.95
    }
}

// decoration.rounding 9 + blur.
window-rule {
    geometry-corner-radius 9
    clip-to-geometry true
    background-effect {
        blur true
    }
}

// decoration.inactive_opacity 0.5
window-rule {
    match is-active=false
    opacity 0.5
}

// Startup apps land on their Hyprland workspaces.
window-rule {
    match at-startup=true app-id=r#"^[Ee]macs$"#
    open-on-workspace "1"
}

window-rule {
    match at-startup=true app-id=r#"^zen"#
    open-on-workspace "2"
}

window-rule {
    match at-startup=true app-id=r#"^org\.wezfurlong\.wezterm$"#
    open-on-workspace "3"
}

// force_sidra_to_special
window-rule {
    match app-id=r#"^[Ss]idra$"#
    open-on-workspace "magic"
}

// Work around WezTerm's initial configure bug by setting an empty default-column-width.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Noctalia: floating settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

binds {
    // ---- Mirrored from hyprland/config/lua/binds.lua ----

    // Actions
    Mod+Return hotkey-overlay-title="Terminal: wezterm" { spawn "wezterm"; }
    Mod+B hotkey-overlay-title="Browser: zen-beta" { spawn "zen-beta"; }
    Mod+F hotkey-overlay-title="Files: luciole" { spawn "luciole"; }
    Mod+Space hotkey-overlay-title="Noctalia launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+E hotkey-overlay-title="Editor: emacs" { spawn "emacs"; }
    Mod+Shift+Q repeat=false { close-window; }
    // niri has no kill action: SIGKILL the focused window's pid.
    Mod+Shift+Ctrl+Q repeat=false { spawn-sh "kill -9 $(niri msg --json focused-window | jq -e .pid)"; }
    Mod+Escape hotkey-overlay-title="Suspend" { spawn-sh "systemctl suspend"; }

    // Noctalia misc
    Mod+Ctrl+D hotkey-overlay-title="Noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Ctrl+B hotkey-overlay-title="Toggle bar" { spawn-sh "noctalia msg bar-toggle"; }
    Mod+Ctrl+P hotkey-overlay-title="Noctalia control center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Ctrl+L hotkey-overlay-title="Lock" { spawn-sh "noctalia msg session lock"; }

    // Movement & window management
    // special:magic emulated with the "magic" named workspace; Mod+S toggles to/from it.
    Mod+Shift+S { move-window-to-workspace "magic" focus=false; }
    Mod+S { spawn-sh "niri msg --json workspaces | jq -e '.[] | select(.is_focused and .name == \"magic\")' >/dev/null && niri msg action focus-workspace-previous || niri msg action focus-workspace magic"; }
    Mod+Ctrl+F { toggle-window-floating; }
    Mod+Shift+M { fullscreen-window; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Ctrl+J { focus-workspace-down; }
    Mod+Ctrl+K { focus-workspace-up; }
    Mod+Shift+J { move-window-to-workspace-down; }
    Mod+Shift+K { move-window-to-workspace-up; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }

    // Monitors & screenshots
    Mod+Comma { focus-monitor-next; }
    Mod+Ctrl+Comma { focus-monitor-previous; }
    Mod+Shift+Comma { move-window-to-monitor-next; }
    Mod+Ctrl+S { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Shift+Ctrl+S { spawn-sh "grim -g \"$(slurp)\" \"$HOME/$(date +%Y-%m-%d-%H%M%S).png\""; }
    // hyprshot -m region/window/output => niri built-in screenshots.
    Mod+F5 { screenshot; }
    Mod+Shift+F5 { screenshot-window; }
    Mod+Ctrl+F5 { screenshot-screen; }

    // Function & media keys
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl set 5%-"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl set 5%+"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_SINK@ toggle"; }

    // ---- niri-only (scrolling layout; no Hyprland equivalent) ----
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+M { maximize-column; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Print { screenshot; }
    // Escape hatch (niri default was Mod+Escape, now suspend).
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}

debug {
    honor-xdg-activation-with-invalid-serial
}
